# Copy to .env and fill in. No real keys are needed to run the mock demo.

# LLM provider (OpenAI-compatible base URL + key)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# Optional: local model (Ollama)
# OLLAMA_MODEL=llama3.2

# External tool integrations (leave blank to keep mocked behavior)
# EMAIL_API_URL=
# EMAIL_API_KEY=
# CALENDAR_API_URL=
# CALENDAR_API_KEY=
# REGISTRATION_API_URL=
# REGISTRATION_API_KEY=
# NOTIFICATION_API_URL=
# NOTIFICATION_API_KEY=
